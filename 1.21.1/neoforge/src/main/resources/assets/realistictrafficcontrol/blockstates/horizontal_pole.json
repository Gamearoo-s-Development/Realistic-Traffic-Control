{
  "multipart": [
    { "apply": { "model": "realistictrafficcontrol:block/horizontal_pole" } },
    { "when": { "north": "true" }, "apply": { "model": "realistictrafficcontrol:block/horizontal_pole_ext" } },
    { "when": { "west": "true" }, "apply": { "model": "realistictrafficcontrol:block/horizontal_pole_ext", "y": 270 } },
    { "when": { "south": "true" }, "apply": { "model": "realistictrafficcontrol:block/horizontal_pole_ext", "y": 180 } },
    { "when": { "east": "true" }, "apply": { "model": "realistictrafficcontrol:block/horizontal_pole_ext", "y": 90 } }
  ]
}
