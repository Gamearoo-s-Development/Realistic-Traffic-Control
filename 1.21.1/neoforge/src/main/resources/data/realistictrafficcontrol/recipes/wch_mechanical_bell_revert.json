{    "type": "minecraft:crafting_shapeless",   "ingredients": [     {         
        param($m)
        $id = $m.Groups[1].Value
        if ($id -like 'traffic_light_bulb*') {
            '"id": "realistictrafficcontrol:traffic_light_bulb", "components": { "realistictrafficcontrol:bulb_type": 0 }'
        } else {
            '"id": "realistictrafficcontrol:' + $id + '"'
        }
         }   ],   "result": {     
        param($m)
        $id = $m.Groups[1].Value
        if ($id -like 'traffic_light_bulb*') {
            '"id": "realistictrafficcontrol:traffic_light_bulb", "components": { "realistictrafficcontrol:bulb_type": 0 }'
        } else {
            '"id": "realistictrafficcontrol:' + $id + '"'
        }
       } }